# ==========================================
# TravelHub Environment Variables for Vercel
# ==========================================

# 1. Database (Neon, Supabase, Railway, or AWS RDS PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-1.aws.neon.tech/travelhub?sslmode=require"

# 2. Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL="https://your-travelhub-app.vercel.app"

# 3. JWT Authentication Secrets
JWT_ACCESS_SECRET="generate_a_secure_random_64_char_key_here"
JWT_REFRESH_SECRET="generate_another_secure_random_64_char_key_here"

# 4. Frontend Configuration (Optional if deployed together on Vercel)
# If backend is hosted separately on Render or Railway, specify it here:
# VITE_API_URL="https://travelhub-backend.onrender.com"

# 5. Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# 6. External APIs (Weather & Maps)
OPENWEATHER_API_KEY="your_openweather_api_key"
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
